# Autonomous Developer Search Gap Radar (Gold Miner)
# Environment Configuration

# Optional: GitHub Personal Access Token (Free)
# Increases GitHub Search API rate limit from 10 req/min (unauthenticated) to 30-60 req/min.
# Generate one for free at: https://github.com/settings/tokens (no special scopes needed, public repo access is sufficient)
GITHUB_TOKEN=

# Optional: Stack Exchange App Key (Free)
# Increases Stack Exchange API quota from 300 to 10,000 req/day
# Generate one for free at: https://stackapps.com/apps/oauth/register
STACKAPPS_KEY=
